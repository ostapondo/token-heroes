{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "eslint/max-lines": [
      "error",
      {
        "max": 200,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "eslint/no-console": "error",
    "eslint/eqeqeq": "error",
    "eslint/no-param-reassign": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "import/no-cycle": "error",
    "import/no-default-export": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/engine/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@content",
                  "@render",
                  "@platform",
                  "react",
                  "react-dom",
                  "@tauri-apps/*",
                  "@i18n"
                ],
                "message": "engine holds pure game rules and imports no other layer"
              },
              {
                "group": [
                  "**/content/**",
                  "**/render/**",
                  "**/platform/**",
                  "**/ui/**",
                  "**/i18n/**"
                ],
                "message": "engine holds pure game rules and imports no other layer"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/content/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@render", "@platform", "react", "react-dom", "@tauri-apps/*", "@i18n"],
                "message": "content is data and may import only @engine"
              },
              {
                "group": [
                  "**/engine/**",
                  "**/render/**",
                  "**/platform/**",
                  "**/ui/**",
                  "**/i18n/**"
                ],
                "message": "reach another layer through its alias, never a path behind it"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/render/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@platform", "react", "react-dom", "@tauri-apps/*"],
                "message": "render draws to canvas and knows nothing of React or the host"
              },
              {
                "group": [
                  "**/engine/**",
                  "**/content/**",
                  "**/platform/**",
                  "**/ui/**",
                  "**/i18n/**"
                ],
                "message": "reach another layer through its alias, never a path behind it"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/platform/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@content", "@render", "react", "react-dom", "@i18n"],
                "message": "platform only talks to the Tauri host"
              },
              {
                "group": [
                  "**/engine/**",
                  "**/content/**",
                  "**/render/**",
                  "**/ui/**",
                  "**/i18n/**"
                ],
                "message": "reach another layer through its alias, never a path behind it"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["src/platform/last-resort.ts"],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["src/i18n/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@engine",
                  "@content",
                  "@render",
                  "@platform",
                  "react",
                  "react-dom",
                  "@tauri-apps/*",
                  "**/engine/**",
                  "**/content/**",
                  "**/render/**",
                  "**/platform/**",
                  "**/ui/**"
                ],
                "message": "i18n holds only catalogues and the translator"
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "src-tauri/target/**",
    "src-tauri/gen/**",
    "styled-system/**",
    "src/ui/**"
  ],
  "extends": ["./.oxlint/strict.json"]
}
